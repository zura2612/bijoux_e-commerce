# Serveur
PORT=3001
NODE_ENV=development

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_64_random_hex_chars_access
JWT_REFRESH_SECRET=change_this_to_64_random_hex_chars_refresh

# Access token : 30 minutes | Refresh token : 7 jours
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=7d

# SQLite
DB_PATH=./data/bijoux.db

# Gmail
GMAIL_USER=ton.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
